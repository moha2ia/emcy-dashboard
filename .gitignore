# Dependencies
node_modules/

# Builds
client/dist/

# Environment & secrets
server/.env
.env.local

# Database & backups (live data never goes to git)
server/data/
.data/

# Uploaded files (keep folder placeholders)
server/uploads/avatars/*
server/uploads/work/*
server/uploads/resources/*
!server/uploads/avatars/.gitkeep
!server/uploads/work/.gitkeep
!server/uploads/resources/.gitkeep

# Logs & pid files
*.log
*.log.err
*-log.txt
*-pid.txt

# Tooling / local
.freebuff/
.DS_Store
Thumbs.db
