# Port for the API (dev). In production Render injects PORT automatically.
PORT=5000

# Secret used to sign auth tokens — MUST be changed in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# Token lifetime
JWT_EXPIRE=7d

# Optional: initial password for the seeded owner admin on a fresh database
# (defaults to admin123 — change the password after first login either way)
# ADMIN_SEED_PASSWORD=

# Optional: override where the database and uploads are stored.
# On Render these point at the persistent disk mount.
# EMCY_DATA_DIR=/var/data
# EMCY_UPLOADS_DIR=/var/data/uploads
